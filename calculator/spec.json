{
  "_readme": [
    "海报/长文的『形态规格』单一事实源。v3.9.1 新增。",
    "背景:同一条规格此前在 check-analysis.ts + 4 份提示词 + README 各写一遍,",
    "     v3.7.1 就出过事故——SKILL 说『≥6句不限篇幅』、bazi-poster 说『3~5句』、",
    "     体检器按 2~6 硬拦,模型写得越满越被打回。",
    "规则:数值只改这里。check-analysis.ts 直接 import 本文件;提示词里的同款数字",
    "     由 fixtures/test-spec-sync.ts 逐条比对,对不上直接 FAIL。"
  ],

  "archetype": {
    "_desc": "判词规格:7 字整句 或 4+4 对仗(中点分隔)",
    "single_len": 7,
    "couplet_len": 4,
    "couplet_separators": ["·", "•", "・"],
    "forbid_pattern": "[格局]{2}|身弱|身强|七杀格|正官格|偏财格",
    "forbid_desc": "判词堆格局术语",
    "mirrored_in": ["prompts/bazi-poster.md", "prompts/zonghe-poster.md", "prompts/ziwei-poster.md", "prompts/bazi-poster-review.md"]
  },

  "sections": {
    "_desc": "各类解读字段的句数/字数下限。上限只对『恰 N 句』类字段存在。",
    "two_sentence_block": {
      "exact_sentences": 2,
      "_desc": "dm/geju/wuxing/yongshen 的 note 类字段:恰两句,第二句以连接词开头"
    },
    "tg_block": {
      "mech_exact_sentences": 1,
      "plain_min_sentences": 6,
      "plain_min_chars": 200,
      "plain_max_sentences": null,
      "plain_max_chars": null,
      "min_good_highlights": 3,
      "_desc": "十神版块:tg.mech_html 用1句压缩盘面证据;tg.plain_html 须≥6句、≥200字、不设上限，完整讲能力结构、现实表现、帮助/代价与行动；至少3处绿色只是机器底线，正向语义仍须零漏标"
    },
    "major_interp": {
      "min_sentences": 6,
      "min_chars": 200,
      "max_sentences": null,
      "max_chars": null,
      "min_highlights": 2,
      "min_good_highlights": 3,
      "_desc": "四大解读段(性格/事业/婚恋/健康):≥6 句、≥200 字、不设上限;每段至少3处hl-good只是机器底线,真正标准是所有正向或偏正向语义逐处绿色粗体、零漏标"
    },
    "close_read": {
      "min_sentences": 3,
      "max_sentences": 7,
      "_desc": "三个精读段(合冲刑害/运岁/神煞):3~7 句"
    },
    "rare_reading": {
      "min_sentences": 4,
      "min_chars": 160,
      "max_sentences": null,
      "max_chars": null,
      "_desc": "罕见现象解读:仅在算法层存在罕象时输出;≥4句、≥160字、不设上限;逐项说明罕见度、偏正向/偏提醒/两面性、现实表现与行动"
    },
    "mbti_diff": {
      "min_chars": 400,
      "max_chars": 650,
      "_desc": "MBTI『实测×底盘』差异版块字数容差"
    },
    "mbti_verdict": {
      "prefix": "你是",
      "max_chars": 34,
      "_desc": "MBTI diff_verdict 判词:须以『你是』开头,不超过 34 字"
    },
    "mirrored_in": ["SKILL.md", "prompts/bazi-poster.md", "prompts/bazi-poster-review.md"]
  },

  "timeline": {
    "exact_items": 5,
    "_desc": "时间轴恰 5 项,年份须落在算法层『运岁引动.建议节点』白名单内",
    "mirrored_in": ["prompts/bazi-poster.md"]
  },

  "algorithm_owned_blocks": {
    "_desc": "八字海报 v2 的五个确定性展示块。owner=algorithm 表示由 chart.json 经渲染层直接投影，不属于 analysis.json，也不要求提示词产出。每块必须同时声明数量、截断与条件显示规则。",
    "exact_blocks": 5,
    "blocks": {
      "tiaohou_classics": {
        "owner": "algorithm",
        "source": "调候条例.命中",
        "prompt_output_required": false,
        "quantity": { "max_items": 3, "order": "source" },
        "truncation": { "field": "意象", "max_chars": 36, "suffix": "…", "unit": "unicode_code_points" },
        "condition": { "show_when": "命中数组非空", "otherwise": "hide_entire_block" }
      },
      "core_insights": {
        "owner": "algorithm",
        "source": ["出口.相神裁决", "出口.轴冲突"],
        "prompt_output_required": false,
        "quantity": { "max_badges": 2, "source_order": ["出口.相神裁决", "出口.轴冲突"] },
        "truncation": { "mode": "fixed_copy_map", "max_chars_per_badge": 28, "suffix": "…" },
        "condition": { "show_when": "任一来源存在", "otherwise": "hide_entire_block" }
      },
      "timeline_triggers": {
        "owner": "algorithm",
        "source": "当前海报关系视图.items + analysis.timeline[].year",
        "prompt_output_required": false,
        "quantity": { "existing_timeline_items": 5, "max_marked_nodes": 5, "max_markers_per_node": 1 },
        "truncation": { "mode": "merge_same_year_to_one_marker", "detail_location": "作用关系区" },
        "condition": { "show_when": "关系引爆窗口与既有 timeline 年份有交集", "otherwise": "leave_timeline_unmarked" }
      },
      "monthly_strip": {
        "owner": "algorithm",
        "source": "流月引动",
        "prompt_output_required": false,
        "quantity": { "exact_months": 12, "best_windows": 1, "worst_windows": 1, "tie_break": "source_order_first" },
        "truncation": { "months": "never_drop", "window_ties": "keep_first_by_source_order" },
        "condition": { "show_when": "流月引动含 12 月且其年份等于 render.currentYear", "otherwise": "hide_entire_block_and_warn_once" }
      },
      "body_grade": {
        "owner": "algorithm",
        "source": "运岁引动.顺逆[].体档",
        "prompt_output_required": false,
        "quantity": { "max_badges_per_row": 1, "rows": "follow_existing_dayun_liunian_rows" },
        "truncation": { "allowed_values": ["强", "中", "弱"], "invalid_or_extra": "omit" },
        "condition": { "show_when": "该行存在合法体档", "otherwise": "preserve_v1_single_axis_layout" }
      }
    }
  },

  "connectors": {
    "_desc": "两句块第二句的开头连接词白名单(v3.7.1 反同质化:原先强制『所以你』×4,一张海报连读四遍像节拍器)。同一张海报内各块应错开。",
    "allow": ["所以你", "意味着你", "这让你", "落到你身上", "这股劲让你", "放到生活里"],
    "mirrored_in": ["prompts/bazi-poster.md", "prompts/bazi-poster-review.md"]
  },

  "forbid": {
    "_desc": "禁词分层。all=所有解读字段;shunni=仅精读/时间轴类字段;mech=幕后台前分离(SKILL 铁律 13)。all_exempt_paths=豁免路径:那里的「命主」不是播报腔而是姓名占位——提示词明写「没提供就填『命主』」,不豁免就自相矛盾(批4 修)。",
    "all": ["tier", "needs_review", "lineage_weights", "命主", "起法待核"],
    "all_exempt_paths": ["^meta\\.name$"],
    "freq": ["多半是你", "你总是", "你每次", "你从不", "你一定会", "第一个想到你"],
    "mech": ["rubric", "算法层", "映射矩阵", "出文协议", "v3加分", "v4加分", "忌神折向", "R1驿马", "R2文", "R3胎元", "评审遍", "体检器", "派系侧重", "lineage"],
    "shunni": ["大凶", "灾年", "凶年", "凶星"],
    "shunni_path_prefix": "^(hechong|yunsui|shensha|timeline)",
    "high_certainty": ["必然", "一定会", "肯定会", "铁定", "必定", "注定"],
    "mirrored_in": ["prompts/bazi-poster.md", "prompts/bazi-prompt.md"]
  },

  "childhood": {
    "_desc": "v3.2.3 童年断言细则:『从小』只能接气质、不能接可证伪的行为;限定词与动作词同句即违规。",
    "marks": ["从小", "小时候", "打小", "孩提", "学生时代", "少年时", "童年"],
    "acts": ["习惯", "牵头", "攒局", "张罗", "带头", "组织", "分工", "派活", "主持", "带队", "发起", "当班长", "当过", "干过", "做过", "拉着", "老是", "总能把", "就爱管"]
  },

  "marriage_anchor": {
    "_desc": "v3.7.1 正缘画像四型分型:锚头由算法层『正缘倾向.宫坐』确定,同盘可复现,不得混用。",
    "by_gongzuo": {
      "正印": "你适合的另一半",
      "偏印": "你适合的另一半",
      "正官": "能接住你的",
      "七杀": "能接住你的",
      "正财": "让你眼睛一亮又留得住的",
      "偏财": "让你眼睛一亮又留得住的",
      "食神": "与你最同频的",
      "伤官": "与你最同频的",
      "比肩": "与你最同频的",
      "劫财": "与你最同频的"
    },
    "mirrored_in": ["prompts/bazi-poster.md", "prompts/bazi-prompt.md"]
  }
}
