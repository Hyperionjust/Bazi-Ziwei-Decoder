{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "校准命例 (calibration case)",
  "description": "一个校准命例。现实事件类含真实生辰属敏感数据, 不入库; 典籍判定类(公开出版物中的历史命例, 住 classics/)无隐私, 入库当回归。",
  "type": "object",
  "required": [
    "id",
    "birth",
    "events"
  ],
  "properties": {
    "case_type": {
      "enum": [
        "典籍判定",
        "现实事件",
        "对照组"
      ],
      "description": "校准类型:典籍判定=金标为书上结论(可入库);现实事件=金标为生平年表(含隐私,不入库);对照组=随机盘/双胞胎/盲测"
    },
    "id": {
      "type": "string",
      "description": "命例代号(现实事件类勿用真名; 典籍判定类为公开历史人物, 用「出处·人名」)"
    },
    "birth": {
      "type": "object",
      "required": [
        "year",
        "month",
        "day",
        "hour",
        "minute",
        "gender"
      ],
      "properties": {
        "year": {
          "type": "integer",
          "minimum": 1800,
          "maximum": 2100
        },
        "month": {
          "type": "integer"
        },
        "day": {
          "type": "integer"
        },
        "hour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23
        },
        "minute": {
          "type": "integer",
          "minimum": 0,
          "maximum": 59
        },
        "gender": {
          "enum": [
            "male",
            "female"
          ]
        },
        "isLunar": {
          "type": "boolean",
          "default": false
        },
        "timeZone": {
          "type": "number",
          "default": 8
        },
        "longitude": {
          "type": "number",
          "description": "东经度数(可选, 真太阳时校正)"
        },
        "time_source": {
          "enum": [
            "证件/记录",
            "本人确认",
            "家人回忆",
            "推测",
            "典籍反推"
          ],
          "description": "时辰可靠度来源(家人回忆/推测的命例其应期评分只作弱参考; 典籍反推=由书载四柱/生辰行反推的输入, 以复现书中四柱为准)"
        },
        "note": {
          "type": "string",
          "description": "生辰来源说明(典籍反推类必填: 反推依据与是否与史载生日互证)"
        }
      }
    },
    "classic": {
      "type": "object",
      "description": "典籍判定类专用: 书上的原文与判定(金标)。算法层输出不写进本文件——金标是书, 算法是被校的一方, 对照表见 classics/README.md",
      "required": [
        "源",
        "原文四柱",
        "断语摘录",
        "韦氏判定"
      ],
      "properties": {
        "源": {
          "type": "string",
          "description": "书名/篇名/素材文件"
        },
        "原文四柱": {
          "type": "string",
          "description": "书载四柱(空格分隔), run-chart 输出必须与之逐字一致"
        },
        "断语摘录": {
          "type": "string",
          "description": "断语核心句照录(为节选, 全文见素材)"
        },
        "韦氏判定": {
          "type": "object",
          "description": "从断语中提炼的结构化金标: 定格/旺衰/用/忌/病/应期要点等, 键名随例"
        }
      }
    },
    "events": {
      "type": "array",
      "description": "已证实生平事件年表(只填当事人确认过的)",
      "items": {
        "type": "object",
        "required": [
          "year",
          "type"
        ],
        "properties": {
          "year": {
            "type": "integer"
          },
          "type": {
            "enum": [
              "换工作",
              "升迁",
              "创业",
              "搬家/迁移",
              "结婚",
              "恋爱变动",
              "离异",
              "生育",
              "大病/手术",
              "破财",
              "进财/置业",
              "学业节点",
              "亲属变故",
              "其他"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "facts": {
      "type": "object",
      "description": "四个校准模块对应的已证实事实(缺哪项该模块跳过)",
      "properties": {
        "yongshen": {
          "type": "string",
          "description": "用神线索: 当事人自述何种方向/环境明显有效或无效"
        },
        "marriage": {
          "type": "object",
          "properties": {
            "spouse_age_diff": {
              "type": "string",
              "description": "配偶年龄关系: 年长/年轻/同龄 + 差几岁"
            },
            "spouse_traits": {
              "type": "string",
              "description": "配偶性格特质(当事人描述)"
            },
            "married_year": {
              "type": "integer"
            }
          }
        },
        "career": {
          "type": "string",
          "description": "实际职业与路径(体制/技艺/经营/合伙等)"
        }
      }
    },
    "scoring": {
      "type": "object",
      "description": "人工评分维度(runner 输出对照表后由人工填, 文件里可留空)",
      "properties": {
        "用神": {
          "type": [
            "number",
            "null"
          ],
          "description": "0/0.5/1"
        },
        "大运应期": {
          "type": [
            "number",
            "null"
          ]
        },
        "婚恋画像": {
          "type": [
            "number",
            "null"
          ]
        },
        "职业方向": {
          "type": [
            "number",
            "null"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
